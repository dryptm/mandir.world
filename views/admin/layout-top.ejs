<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0"/>
  <title><%= title %> — Mandir.World Admin</title>
  <style>
    *{margin:0;padding:0;box-sizing:border-box}
    body{background:#0f0800;font-family:'Inter',system-ui,sans-serif;color:#FDF6E3;display:flex;min-height:100vh;overflow-x:hidden}
    html{overflow-x:hidden}

    /* SIDEBAR */
    .sidebar{width:220px;background:#1A0F00;border-right:1px solid rgba(200,146,42,.15);display:flex;flex-direction:column;position:fixed;top:0;left:0;bottom:0;z-index:200;transition:transform .25s ease}
    .sb-logo{padding:1.5rem 1.25rem 1rem;border-bottom:1px solid rgba(200,146,42,.1);display:flex;align-items:center;justify-content:space-between}
    .sb-logo .om{color:#C8922A;font-size:1.4rem}
    .sb-logo h2{font-size:.95rem;color:#FDF6E3;margin:.2rem 0 .1rem}
    .sb-logo p{font-size:.65rem;color:rgba(253,246,227,.3);letter-spacing:1.5px;text-transform:uppercase}
    .sb-close{display:none;background:none;border:none;color:rgba(253,246,227,.5);font-size:1.4rem;cursor:pointer;line-height:1;padding:.25rem}
    .sb-nav{padding:.75rem 0;flex:1;overflow-y:auto}
    .sb-section{padding:.4rem 1rem .2rem;font-size:.62rem;color:rgba(253,246,227,.25);letter-spacing:1.5px;text-transform:uppercase}
    .sb-link{display:flex;align-items:center;gap:.6rem;padding:.75rem 1.25rem;color:rgba(253,246,227,.55);font-size:.85rem;text-decoration:none;transition:all .15s;border-left:3px solid transparent}
    .sb-link:hover{color:#FDF6E3;background:rgba(255,255,255,.04)}
    .sb-link.active{color:#C8922A;background:rgba(200,146,42,.08);border-left-color:#C8922A}
    .sb-link .icon{width:16px;text-align:center;font-size:.9rem}
    .sb-footer{padding:1rem 1.25rem;border-top:1px solid rgba(200,146,42,.1)}
    .sb-footer a{color:rgba(253,246,227,.3);font-size:.75rem;text-decoration:none}
    .sb-footer a:hover{color:#FDF6E3}

    /* OVERLAY (mobile drawer backdrop) */
    .sb-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:150}
    .sb-overlay.open{display:block}

    /* MAIN */
    .main{margin-left:220px;flex:1;display:flex;flex-direction:column;min-height:100vh;min-width:0}
    .topbar{background:#1A0F00;border-bottom:1px solid rgba(200,146,42,.1);padding:.85rem 1.25rem;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:50;gap:.75rem}
    .topbar h1{font-size:1rem;font-weight:600;color:#FDF6E3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .topbar-right{display:flex;align-items:center;gap:.75rem;flex-shrink:0}
    .tb-live{display:flex;align-items:center;gap:.4rem;font-size:.75rem;color:rgba(253,246,227,.45)}
    .tb-live-dot{width:6px;height:6px;background:#22c55e;border-radius:50%;animation:pulse 1.5s ease infinite}
    @keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
    .tb-logout{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);color:rgba(253,246,227,.6);padding:.4rem .75rem;border-radius:6px;font-size:.75rem;text-decoration:none;transition:all .2s;white-space:nowrap}
    .tb-logout:hover{background:rgba(220,38,38,.15);border-color:rgba(220,38,38,.3);color:#f87171}

    /* HAMBURGER (mobile only) */
    .hamburger{display:none;background:none;border:none;color:#FDF6E3;font-size:1.3rem;cursor:pointer;padding:.25rem .5rem;flex-shrink:0}

    .content{padding:1.5rem;flex:1;min-width:0;max-width:100vw}

    /* CARDS */
    .stat-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:.85rem;margin-bottom:1.5rem}
    .stat-card{background:#1A0F00;border:1px solid rgba(200,146,42,.15);border-radius:12px;padding:1rem 1.1rem;min-width:0}
    .stat-card .sc-label{font-size:.68rem;color:rgba(253,246,227,.4);text-transform:uppercase;letter-spacing:.06em;margin-bottom:.35rem}
    .stat-card .sc-value{font-size:1.5rem;font-weight:700;color:#FDF6E3;line-height:1;word-break:break-word}
    .stat-card .sc-sub{font-size:.7rem;color:rgba(253,246,227,.35);margin-top:.3rem}
    .stat-card.gold .sc-value{color:#C8922A}
    .stat-card.green .sc-value{color:#22c55e}

    /* TABLE — wrapped in scrollable container */
    .section-card{background:#1A0F00;border:1px solid rgba(200,146,42,.12);border-radius:12px;overflow:hidden;margin-bottom:1.25rem;min-width:0}
    .section-header{padding:.9rem 1.1rem;border-bottom:1px solid rgba(200,146,42,.1);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.6rem}
    .section-header h2{font-size:.9rem;font-weight:600}
    .section-header .count{background:rgba(200,146,42,.15);color:#C8922A;padding:.2rem .6rem;border-radius:50px;font-size:.7rem;font-weight:600;white-space:nowrap}
    .table-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
    table{width:100%;border-collapse:collapse;min-width:640px}
    thead th{padding:.65rem .85rem;text-align:left;font-size:.68rem;color:rgba(253,246,227,.35);text-transform:uppercase;letter-spacing:.05em;border-bottom:1px solid rgba(255,255,255,.06);white-space:nowrap}
    tbody td{padding:.7rem .85rem;font-size:.8rem;color:rgba(253,246,227,.75);border-bottom:1px solid rgba(255,255,255,.04)}
    tbody tr:last-child td{border-bottom:none}
    tbody tr:hover td{background:rgba(255,255,255,.02)}
    .badge{padding:.2rem .55rem;border-radius:50px;font-size:.66rem;font-weight:600;white-space:nowrap}
    .badge-green{background:rgba(34,197,94,.15);color:#22c55e}
    .badge-yellow{background:rgba(234,179,8,.15);color:#eab308}
    .badge-red{background:rgba(220,38,38,.15);color:#f87171}
    .badge-blue{background:rgba(59,130,246,.15);color:#60a5fa}
    .action-btn{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);color:rgba(253,246,227,.7);padding:.35rem .65rem;border-radius:6px;font-size:.72rem;cursor:pointer;text-decoration:none;transition:all .15s;white-space:nowrap;display:inline-block}
    .action-btn:hover{background:rgba(200,146,42,.15);border-color:rgba(200,146,42,.3);color:#C8922A}
    .action-btn.danger:hover{background:rgba(220,38,38,.15);border-color:rgba(220,38,38,.3);color:#f87171}
    .empty-state{padding:2rem 1.5rem;text-align:center;color:rgba(253,246,227,.3);font-size:.82rem}

    /* Scroll hint for tables on mobile */
    .scroll-hint{display:none;padding:.5rem 1.1rem;font-size:.68rem;color:rgba(253,246,227,.3);background:rgba(200,146,42,.05);border-bottom:1px solid rgba(255,255,255,.04)}

    /* TOGGLE */
    .toggle-wrap{display:flex;align-items:center;gap:.5rem}
    .toggle{position:relative;width:36px;height:20px;flex-shrink:0}
    .toggle input{opacity:0;width:0;height:0}
    .toggle-slider{position:absolute;inset:0;background:rgba(255,255,255,.15);border-radius:50px;cursor:pointer;transition:.25s}
    .toggle-slider::before{content:'';position:absolute;width:14px;height:14px;left:3px;bottom:3px;background:#fff;border-radius:50%;transition:.25s}
    .toggle input:checked + .toggle-slider{background:#22c55e}
    .toggle input:checked + .toggle-slider::before{transform:translateX(16px)}

    /* ── MOBILE BREAKPOINT ─────────────────────────── */
    @media(max-width:900px){
      .sidebar{transform:translateX(-100%)}
      .sidebar.open{transform:translateX(0)}
      .sb-close{display:block}
      .main{margin-left:0}
      .hamburger{display:block}
      .topbar h1{font-size:.92rem}
      .tb-live span, .tb-live{display:none}
      .content{padding:1rem}
      .stat-grid{grid-template-columns:repeat(2,1fr);gap:.6rem}
      .scroll-hint{display:block}
      .section-header{padding:.85rem 1rem}
      .section-header h2{font-size:.85rem}
    }
    @media(max-width:420px){
      .stat-grid{grid-template-columns:1fr 1fr}
      .stat-card .sc-value{font-size:1.3rem}
      .topbar{padding:.7rem 1rem}
    }
  </style>
</head>
<body>

<div class="sb-overlay" id="sbOverlay" onclick="closeSidebar()"></div>

<div class="sidebar" id="sidebar">
  <div class="sb-logo">
    <div>
      <div class="om">🕉️</div>
      <h2>Mandir.World</h2>
      <p>Admin Panel</p>
    </div>
    <button class="sb-close" onclick="closeSidebar()" aria-label="Close menu">✕</button>
  </div>
  <nav class="sb-nav">
    <div class="sb-section">Overview</div>
    <a href="/admin" class="sb-link <%= page==='dashboard' ? 'active' : '' %>"><span class="icon">📊</span> Dashboard</a>

    <div class="sb-section">Transactions</div>
    <a href="/admin/donations" class="sb-link <%= page==='donations' ? 'active' : '' %>"><span class="icon">🪔</span> Donations</a>
    <a href="/admin/bookings"  class="sb-link <%= page==='bookings'  ? 'active' : '' %>"><span class="icon">🙏</span> Puja Bookings</a>
    <a href="/admin/sankalpas" class="sb-link <%= page==='sankalpas' ? 'active' : '' %>"><span class="icon">🕉️</span> Sankalpas</a>
    <a href="/admin/stories" class="sb-link <%= page==='stories' ? 'active' : '' %>"><span class="icon">💬</span> Devotee Stories</a>

    <div class="sb-section">Content</div>
    <a href="/admin/streams"   class="sb-link <%= page==='streams'   ? 'active' : '' %>"><span class="icon">📺</span> Streams</a>
    <a href="/admin/festivals" class="sb-link <%= page==='festivals' ? 'active' : '' %>"><span class="icon">📅</span> Festivals</a>
    <a href="/admin/pujas"     class="sb-link <%= page==='pujas'     ? 'active' : '' %>"><span class="icon">🛕</span> Pujas</a>

    <div class="sb-section">Site</div>
    <a href="/" target="_blank" class="sb-link"><span class="icon">🌐</span> View Site</a>
  </nav>
  <div class="sb-footer">
    <a href="/admin/logout">← Logout</a>
  </div>
</div>

<div class="main">
  <div class="topbar">
    <div style="display:flex;align-items:center;gap:.6rem;min-width:0">
      <button class="hamburger" onclick="openSidebar()" aria-label="Open menu">☰</button>
      <h1><%= title %></h1>
    </div>
    <div class="topbar-right">
      <div class="tb-live"><div class="tb-live-dot"></div> <span>Live</span></div>
      <a href="/admin/logout" class="tb-logout">Logout</a>
    </div>
  </div>
  <div class="content">
