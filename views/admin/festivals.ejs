<%- include('layout-top', { title: 'Festivals', page: 'festivals' }) %>

<div class="section-card">
  <div class="section-header">
    <h2>Festival Calendar</h2>
    <div style="display:flex;gap:.5rem;align-items:center">
      <span class="count"><%= festivals.length %> festivals</span>
      <a href="/admin/festivals/bulk-upload" class="action-btn">📋 Bulk Upload</a>
      <a href="/admin/festivals/new" class="btn-primary-sm">+ Add Festival</a>
    </div>
  </div>
  <div class="scroll-hint">← Swipe to see more →</div>
  <div class="table-scroll">
<table>
    <thead><tr>
      <th>Festival</th><th>Date</th><th>Deity</th><th>Category</th><th>Active</th><th>Actions</th>
    </tr></thead>
    <tbody>
    <% festivals.forEach(f => { %>
    <tr>
      <td>
        <span style="font-size:1.1rem;margin-right:.4rem"><%= f.icon %></span>
        <strong><%= f.name %></strong>
        <div style="color:rgba(253,246,227,.35);font-size:.7rem;font-family:'Noto Sans Devanagari',sans-serif"><%= f.hindi %></div>
      </td>
      <td style="color:rgba(253,246,227,.6)">
        <%= f.isDaily ? 'Daily' : new Date(f.date).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %>
      </td>
      <td style="color:rgba(253,246,227,.55)"><%= f.deity %></td>
      <td>
        <span class="badge <%= f.category === 'major' ? 'badge-blue' : f.category === 'daily' ? 'badge-green' : 'badge-yellow' %>">
          <%= f.category %>
        </span>
      </td>
      <td>
        <form method="POST" action="/admin/festivals/<%= f._id %>/toggle-active">
          <label class="toggle">
            <input type="checkbox" <%= f.active !== false ? 'checked' : '' %> onchange="this.form.submit()"/>
            <span class="toggle-slider"></span>
          </label>
        </form>
      </td>
      <td>
        <div style="display:flex;gap:.4rem">
          <a href="/admin/festivals/<%= f._id %>/edit" class="action-btn">Edit</a>
          <form method="POST" action="/admin/festivals/<%= f._id %>/delete"
            onsubmit="return confirm('Delete &quot;<%= f.name %>&quot;? This cannot be undone.')">
            <button type="submit" class="action-btn danger">Delete</button>
          </form>
        </div>
      </td>
    </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
</div>

<style>
  .btn-primary-sm {
    background: #FF6B00; color: #fff; border: none; border-radius: 6px;
    padding: .35rem .85rem; font-size: .78rem; font-weight: 600; text-decoration: none;
    display: inline-block;
  }
  .btn-primary-sm:hover { background: #e05d00; }
</style>

<%- include('layout-bottom') %>
