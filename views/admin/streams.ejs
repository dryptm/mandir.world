<%- include('layout-top', { title: 'Streams', page: 'streams' }) %>

<div class="section-card">
  <div class="section-header">
    <h2>Temple Streams</h2>
    <div style="display:flex;gap:.5rem;align-items:center">
      <span class="count"><%= streams.length %> streams</span>
      <a href="/admin/streams/new" class="btn-primary-sm">+ Add Stream</a>
    </div>
  </div>
  <div class="scroll-hint">← Swipe to see more →</div>
  <div class="table-scroll">
<table>
    <thead><tr>
      <th>Temple</th><th>City</th><th>Deity</th><th>YouTube Video ID</th><th>Live</th><th>Platform Views</th><th>Active</th><th>Actions</th>
    </tr></thead>
    <tbody>
    <% streams.forEach(s => { %>
    <tr>
      <td>
        <strong><%= s.title %></strong>
        <div style="color:rgba(253,246,227,.35);font-size:.7rem"><%= s.hindi %></div>
      </td>
      <td><%= s.city %>, <%= s.state %></td>
      <td style="color:rgba(253,246,227,.55)"><%= s.deity %></td>
      <td style="font-size:.75rem;color:rgba(253,246,227,.5)"><%= s.youtubeVideoId || '—' %></td>
      <td>
        <form method="POST" action="/admin/streams/<%= s._id %>/toggle-live">
          <label class="toggle">
            <input type="checkbox" <%= s.isLive ? 'checked' : '' %> onchange="this.form.submit()"/>
            <span class="toggle-slider"></span>
          </label>
        </form>
      </td>
      <td>
        <%= (s.platformViews || 0).toLocaleString('en-IN') %>
        <div style="font-size:.65rem;color:rgba(253,246,227,.35)">+ real-time YouTube live viewers, when live</div>
      </td>
      <td>
        <form method="POST" action="/admin/streams/<%= s._id %>/toggle-active">
          <label class="toggle">
            <input type="checkbox" <%= s.active !== false ? 'checked' : '' %> onchange="this.form.submit()"/>
            <span class="toggle-slider"></span>
          </label>
        </form>
      </td>
      <td>
        <div style="display:flex;gap:.4rem">
          <a href="/admin/streams/<%= s._id %>/edit" class="action-btn">Edit</a>
          <form method="POST" action="/admin/streams/<%= s._id %>/delete"
            onsubmit="return confirm('Delete &quot;<%= s.title %>&quot;? This cannot be undone.')">
            <button type="submit" class="action-btn danger">Delete</button>
          </form>
        </div>
      </td>
    </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
</div>

<style>
  .btn-primary-sm {
    background: #FF6B00; color: #fff; border: none; border-radius: 6px;
    padding: .35rem .85rem; font-size: .78rem; font-weight: 600; text-decoration: none;
    display: inline-block;
  }
  .btn-primary-sm:hover { background: #e05d00; }
</style>

<%- include('layout-bottom') %>
